    "EXTRACT_DIR = WORK_DIR / \"images\"\n",
    "\n",
    "# 1) Unzip into a clean folder (skip Mac junk files). Re-extract if the folder is missing or has no images.\n",
    "IMG_EXT = (\".jpg\", \".jpeg\", \".png\")\n",
